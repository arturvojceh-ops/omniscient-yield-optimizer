GOERLI_URL=https://eth-goerli.alchemyapi.io/v2/your_api_key
SEPOLIA_URL=https://eth-sepolia.alchemyapi.io/v2/your_api_key
ARBITRUM_URL=https://arb-mainnet.alchemyapi.io/v2/your_api_key
OPTIMISM_URL=https://opt-mainnet.alchemyapi.io/v2/your_api_key
POLYGON_URL=https://polygon-mainnet.alchemyapi.io/v2/your_api_key

# 🔍 API Keys for Contract Verification
ETHERSCAN_API_KEY=your_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
OPTIMISM_API_KEY=your_optimism_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# 📊 Gas Reporting
REPORT_GAS=true

# 🏛️ Protocol Addresses (Mainnet)
AAVE_POOL=0x87870Bca3F3fD833Eb4057548e0E20766706aB57
COMPOUND_COMPTROLLER=0x3d9819210A31b4961b30EF54bE2aeD79B9c9Cd3B
UNISWAP_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
CHAINLINK_PRICE_FEED=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419

# 🏛️ Protocol Addresses (Goerli Testnet)
AAVE_POOL_GOERLI=0x6Ae43d0278C5fFDb9a0155448574320910D6A6C5
COMPOUND_COMPTROLLER_GOERLI=0x872543FDB3E49c1d6f2E8D2a0E3C473D8Ae5ac65
UNISWAP_ROUTER_GOERLI=0x3bFA4769FB09eefD5aAd6634956b5D5C7B8859a6
CHAINLINK_PRICE_FEED_GOERLI=0xD4a33860578261CfA79A5A8F7b9A4C5F5c8A9C8F

# 🎛️ Contract Configuration
INITIAL_SUPPLY=60000000000000000000000000
PERFORMANCE_FEE=500
EMERGENCY_FEE=200
MAX_DEPOSIT_AMOUNT=1000000000000000000000000
MAX_PERFORMANCE_FEE=1000
MAX_EMERGENCY_FEE=500

# 📈 Strategy Parameters
MAX_ALLOCATION_PER_PROTOCOL=5000
PERFORMANCE_THRESHOLD=100
REBALANCE_THRESHOLD=500
EMERGENCY_THRESHOLD=1000
BATCH_REBALANCE_SIZE=10

# 🗳️ Governance Parameters
VOTING_DELAY=86400
VOTING_PERIOD=604800
PROPOSAL_THRESHOLD=100000000000000000000000
QUORUM_VOTES=1000000000000000000000000

# 💰 Token Parameters
TRANSFER_FEE=100
MAX_TRANSFER_FEE=500
TOTAL_SUPPLY=100000000000000000000000000
INITIAL_MINT_AMOUNT=60000000000000000000000000

# 🔒 Security Parameters
MULTISIG_THRESHOLD=3
MULTISIG_TOTAL=5
TIMELOCK_DELAY=172800
INSURANCE_FUND_PERCENTAGE=200

# 📊 Monitoring Parameters
YIELD_DISTRIBUTION_INTERVAL=3600
REBALANCE_INTERVAL=86400
PERFORMANCE_CHECK_INTERVAL=3600
EMERGENCY_CHECK_INTERVAL=1800

# 🌐 Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_APP_NAME=Omniscient Yield Optimizer
NEXT_PUBLIC_VERSION=2.0.0

# 📈 Analytics Configuration
ANALYTICS_ENABLED=true
PERFORMANCE_TRACKING=true
USER_ANALYTICS=false
ERROR_REPORTING=true

# 🧪 Testing Configuration
TEST_TIMEOUT=60000
TEST_GAS_LIMIT=8000000
TEST_BLOCK_GAS_LIMIT=30000000

# 📦 Deployment Configuration
DEPLOY_VERIFICATION=true
DEPLOY_AUTOMINE=true
DEPLOY_TIMEOUT=300000

# 🔧 Development Configuration
DEBUG=false
VERBOSE_LOGGING=true
ENABLE_TRACING=false
ENABLE_PROFILING=false

# 🌍 Environment Configuration
NODE_ENV=development
NETWORK=hardhat
CHAIN_ID=31337

# 📱 Notification Configuration
DISCORD_WEBHOOK_URL=your_discord_webhook_url
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
EMAIL_NOTIFICATIONS=false

# 💾 Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/omniscient_yeild
REDIS_URL=redis://localhost:6379

# 📊 External Services
COINGECKO_API_KEY=your_coingecko_api_key
DEFILLAMA_API_KEY=your_defillama_api_key
THE_GRAPH_API_KEY=your_graph_api_key

# 🔐 Security Configuration
JWT_SECRET=your_jwt_secret_minimum_32_characters
ENCRYPTION_KEY=your_encryption_key_minimum_32_characters
SESSION_SECRET=your_session_secret_minimum_32_characters

# 🌐 CORS Configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# 📈 Rate Limiting
RATE_LIMIT_WINDOW=90000
RATE_LIMIT_MAX=1000

# 🚀 Performance Configuration
ENABLE_CACHING=true
CACHE_TTL=3600
ENABLE_COMPRESSION=true
ENABLE_MINIFICATION=true

# 📝 Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=100m
LOG_MAX_FILES=5

# 🧪 Feature Flags
ENABLE_BATCH_OPERATIONS=true
ENABLE_EMERGENCY_MODE=true
ENABLE_GOVERNANCE=true
ENABLE_INSURANCE=true
ENABLE_PERFORMANCE_FEES=true

# 📊 Business Intelligence
ENABLE_ANALYTICS=true
ENABLE_REPORTING=true
ENABLE_DASHBOARDS=true
ENABLE_ALERTS=true

# 🌍 Localization
LOCALE=en-US
TIMEZONE=UTC
DATE_FORMAT=YYYY-MM-DD HH:mm:ss
CURRENCY=USD

# 🚀 Advanced Configuration
ENABLE_ADVANCED_OPTIMIZATION=true
ENABLE_DYNAMIC_FEES=true
ENABLE_RISK_MANAGEMENT=true
ENABLE_AUTOMATIC_REBALANCING=true
ENABLE_PREDICTIVE_ANALYTICS=false
