# 🚀 OMNISCIENT YIELD OPTIMIZER - ENVIRONMENT CONFIGURATION

# 🔐 Private Keys (NEVER commit real keys to repository)
PRIVATE_KEY=your_private_key_here
PRIVATE_KEY_GOERLI=your_goerli_private_key_here
PRIVATE_KEY_SEPOLIA=your_sepolia_private_key_here

# 🌐 Network URLs
