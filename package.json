{
  "name": "omniscient-yield-optimizer",
  "version": "2.0.0",
  "description": "Advanced DeFi 2.0 Protocol with Multi-Strategy Yield Optimization",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:goerli": "hardhat run scripts/deploy.js --network goerli",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "verify": "hardhat verify --network",
    "clean": "hardhat clean",
    "size": "hardhat size-contracts",
    "gas-report": "REPORT_GAS=true hardhat test",
    "slither": "slither .",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol'",
    "prettier-check": "prettier --check 'contracts/**/*.sol'",
    "docs": "hardhat docgen",
    "node": "hardhat node",
    "console": "hardhat console"
  },
  "keywords": [
    "defi",
    "yield-farming",
    "ethereum",
    "solidity",
    "smart-contracts",
    "erc4626",
    "vault",
    "optimization",
    "gas-efficient",
    "enterprise-security",
    "layer-2",
    "multi-strategy"
  ],
  "author": "Omniscient Yield Optimizer Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arturvojceh-ops/omniscient-yield-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/arturvojceh-ops/omniscient-yield-optimizer/issues"
  },
  "homepage": "https://github.com/arturvojceh-ops/omniscient-yield-optimizer#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^5.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "chai": "^4.2.0",
    "ethers": "^6.4.0",
    "hardhat": "^2.19.0",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-docgen": "^1.3.0",
    "hardhat-gas-reporter": "^1.0.8",
    "prettier": "^2.8.4",
    "prettier-plugin-solidity": "^1.1.3",
    "solhint": "^3.6.2",
    "solidity-coverage": "^0.8.1",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.0",
    "typescript": ">=4.5.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
